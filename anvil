#!/usr/bin/env bash
# Anvil entrypoint.
#
# This script does exactly one job: make a suitable Python environment exist,
# then hand over to it. All behaviour lives in anvilkit/, and none of it belongs
# here - the previous 465-line version is kept as anvil.bash.bak for one release.
#
# Usage:
#   ./anvil <command> [options]     # see ./anvil --help
#   ./anvil --rebuild-venv ...      # discard and recreate .venv first
#   ./anvil --no-venv ...           # use an ambient interpreter (CI manages its own)

set -euo pipefail

# Resolve this script's real location so ./anvil works through a symlink and
# from any working directory.
source_path="${BASH_SOURCE[0]}"
while [[ -h "$source_path" ]]; do
    script_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
    source_path="$(readlink "$source_path")"
    [[ $source_path != /* ]] && source_path="$script_dir/$source_path"
done
repo_root="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
cd "$repo_root"

bootstrap_mode=""

# Consume only the flags that select an environment; everything else is the
# Python CLI's business and is forwarded untouched.
case "${1:-}" in
    --rebuild-venv)
        bootstrap_mode="--rebuild"
        shift
        ;;
    --no-venv)
        bootstrap_mode="--no-venv"
        shift
        ;;
esac

python_bin="$("$repo_root/scripts/bootstrap.sh" $bootstrap_mode)"

# exec so signals (Ctrl-C during 'logs') and exit codes pass straight through.
exec "$python_bin" -m anvilkit.cli "$@"
