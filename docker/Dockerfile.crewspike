# Crew-spike image: the Pi CLI, the crew extension and the anvilkit
# harness, in one container — the crew spike of iar3-r8/anvil#84.
# The host needs only Docker — no sudo, no global installs, nothing on host
# system paths. Runs on the Compose llm-network and reaches the llama-swap
# gateway by service name.
FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-yaml bash ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Exact pins: reproducible spike; bumps are deliberate.
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.3.0 pi-crew@0.11.57

# The harness, copied in from the build context (the repo root).
COPY anvilkit/ /app/anvilkit/

# Non-root: the fixture and the agent home are written by this user.
# The agent home is created in the image (not just the volume mountpoint):
# Docker's first-mount copy-up only transfers content that exists at the
# mountpoint, so without it the named volume lands root-owned and the
# container user cannot write models.json into it.
# One line: the agent-home mkdir + chown must sit on the first physical
# line of the RUN instruction.
RUN useradd --create-home --shell /bin/bash crewspike && mkdir -p /workspace /home/crewspike/.pi/agent && chown -R crewspike:crewspike /app /workspace /home/crewspike/.pi/agent
ENV PYTHONPATH=/app
USER crewspike
WORKDIR /workspace
