{
    "name": "Anvil",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "runArgs": [
        "--network=host",
        "--security-opt=no-new-privileges:true",
        "--cap-drop=ALL",
        "--shm-size=2g"
    ],

    "remoteUser": "vscode",

    "containerEnv": {
        "ANVIL_IN_CONTAINER": "1"
    },

    "remoteEnv": {
        "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
    },

    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/anvil,type=bind,consistency=delegated",
    "workspaceFolder": "/workspaces/anvil",


    "customizations": {
        "vscode": {
            "extensions": [
                "zoocodeorganization.zoo-code"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/anvil/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "postCreateCommand": "bash scripts/bootstrap.sh"
}
